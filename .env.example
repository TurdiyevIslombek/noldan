# Copy to .env.local for local dev, and set the same in Vercel's dashboard.
# Never commit a filled-in copy — .env* is gitignored except this template.

# ======================================================================
# Tutor  (server-side only, never reaches the browser)
# ======================================================================
# Only ONE key is needed — the proxy picks the first it finds.
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# HF_TOKEN=

# Optional
# TUTOR_MODEL=llama-3.3-70b-versatile


# ======================================================================
# Database + sign-in  (accounts, entitlements, orders, progress)
# ======================================================================
# All server-side. None of these may ever get a VITE_ prefix: anything
# prefixed VITE_ is compiled into JavaScript every visitor downloads.
# Step by step: DEPLOY.md, section 4.

# Postgres. Production: Neon's free plan, added from Vercel → Storage,
# which sets this for you. Locally: `npm run db:dev` prints one.
DATABASE_URL=

# Signs the login cookies. Any long random string:  openssl rand -base64 32
# Changing it signs everybody out (no data is lost).
BETTER_AUTH_SECRET=

# Optional. The address sign-in returns to; defaults to SITE_URL.
# BETTER_AUTH_URL=https://noldan.uz

# Telegram — @BotFather → your bot → Login Widget.
# Allowed URLs:  https://<host>  and  https://<host>/api/auth/callback/telegram
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=

# Google — Google Cloud → Google Auth Platform → Clients → Web application.
# Authorized redirect URI:  https://<host>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ======================================================================
# Payments — Payme (Paycom)
# ======================================================================
# From the Payme merchant cabinet. Requires a registered YaTT/MChJ and a
# signed merchant contract; use the sandbox values until then.
#
# Register this endpoint with Payme:  https://<host>/api/payme
# Register the account field as:      order_id

PAYME_MERCHANT_ID=
PAYME_KEY=
# Sandbox: https://test.paycom.uz  ·  Production: https://checkout.paycom.uz
PAYME_CHECKOUT_URL=https://test.paycom.uz


# ======================================================================
# Payments — Click
# ======================================================================
# Register BOTH Prepare and Complete against:  https://<host>/api/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=


# ======================================================================
# Build-time (baked into the static output)
# ======================================================================
# The public origin, with no trailing slash. Used for canonical, og:image,
# robots.txt, sitemap.xml AND the return URL a payer lands on after
# paying. Defaults to https://noldan.uz — set it to the *.vercel.app URL
# until the domain is live, or link previews and payment returns point at
# a host that does not resolve yet.
# SITE_URL=https://noldan.uz

# Comma-separated. The *.vercel.app URL is allowed automatically; set this
# once a custom domain is attached.
# ALLOWED_ORIGINS=https://noldan.uz,https://www.noldan.uz

# Makes the GitHub icon in the nav a real link. Unset, it stays inert.
# VITE_GITHUB_URL=https://github.com/<you>/noldan
